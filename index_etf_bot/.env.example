# Copy to .env. Never share .env. India time, rupees.

# What to buy, as ETF:weight. Examples:
#   NIFTYBEES:100                          NIFTY 50 only
#   NIFTYBEES:70,MON100:30                 NIFTY 50 + US Nasdaq 100 (traded on NSE)
#   NIFTYBEES:60,MON100:25,GOLDBEES:15     + gold
ETFS=NIFTYBEES:100
SIP_AMOUNT=10000
# first trading day on or after this day of the month; orders after SIP_AFTER
SIP_DAY=1
SIP_AFTER=09:45
# hold the month's money as cash while NIFTY is below its 200-day average (the backtest says this lowered returns)
PAUSE_BELOW_200DMA=false

# false = paper (no real orders). true = real orders, only if readiness.py passes.
LIVE_TRADING=false

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
STATIC_IP=

# Charges on a delivery buy (verify on angelone.in)
BROKERAGE_PCT=0.1
BROKERAGE_MAX=20
BROKERAGE_MIN=5
STAMP_BUY_PCT=0.015
EXCHANGE_TXN_PCT=0.00297
SEBI_FEE_PCT=0.0001
GST_PCT=18
ASSUMED_SPREAD_PCT=0.05

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
