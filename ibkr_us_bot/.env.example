# Copy to .env and fill in. Never share .env. Times are New York time (ET), money in US dollars.

# Interactive Brokers: TWS or IB Gateway must be running and logged in, with
# Configure > API > Settings > "Enable ActiveX and Socket Clients" ticked.
# Ports: TWS paper 7497, TWS live 7496, IB Gateway paper 4002, IB Gateway live 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
IB_ACCOUNT=
# use free 15-minute-delayed quotes when you have no live US market data subscription
IB_DELAYED_DATA=true

# false = paper trading (fake money, real prices). true = real orders, only if readiness.py passes.
LIVE_TRADING=false
PAPER_START_BALANCE=5000

# Universe: S&P 500. WATCH=AAPL,MSFT to fix the list.
UNIVERSE=SP500
WATCH_SIZE=30
WATCH=
BLOCKED=
MIN_PRICE=10
NEWS_CHECK=true
# SEC EDGAR asks you to identify yourself to read 8-K filings, e.g. "Your Name you@example.com"
SEC_USER_AGENT=

# Entry: opening range 9:30-9:45, first 5-minute close above it triggers (cutoff 12:30 on a 1 p.m. early close)
OR_MINUTES=15
# trigger bar volume vs the range average; 0 = off (the original pack's default: the 9:30 bar holds the opening auction)
MIN_VOLUME_X=0
NO_ENTRIES_BEFORE=09:45
NO_ENTRIES_AFTER=15:30
USE_LEVEL_SETUP=true
TREND_FILTER=true

# Exit: or-mid | or-low | pct:X | atr:K ; target in R ; out by FLAT_BY (12:55 on an early close)
STOP_RULE=or-mid
LEVEL_STOP_RULE=atr:1.5
TARGET_R=2
FLAT_BY=15:55
ASSUMED_SPREAD_PCT=0.02

# Time Machine
TM_REPLAYS=10000
TM_SEED=19
TM_MIN_DAYS=20
TM_MIN_EDGE_PTS=0

# Budget and risk (US dollars; the original pack's example config)
BUDGET=5000
CASH_BUFFER_PCT=10
MAX_POSITION_PCT=75
MAX_ORDER=4000
MIN_ORDER=100
MAX_LOSS_PER_TRADE=50
MAX_DAILY_LOSS=150
MAX_TRADES_PER_DAY=3
MAX_ORDERS_PER_DAY=10
MAX_OPEN_POSITIONS=2
MIN_REWARD_RISK=1.0
# turn on if your account still applies the old pattern-day-trader rule
PDT_GUARD=false

# Charges: IBKR Pro Fixed (verify on interactivebrokers.com)
COMMISSION_PER_SHARE=0.005
COMMISSION_MIN=1.0
COMMISSION_MAX_PCT=1.0
SEC_FEE_RATE=0.0000206
FINRA_TAF_PER_SHARE=0.000195
FINRA_TAF_MAX=9.79

# TradingView webhook (optional): alerts go through the same checks before any order
TV_WEBHOOK=false
TV_PORT=8788
TV_SECRET=
TV_ONLY=false

# Telegram (optional): token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Extra NYSE holidays (YYYY-MM-DD, comma separated), e.g. for 2028
NYSE_HOLIDAYS=

POLL_SECONDS=20
