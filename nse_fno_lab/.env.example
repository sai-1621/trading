# Copy to .env and fill in. Never share .env.
BROKER=angelone
LIVE_TRADING=false
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

CAPITAL=300000
MAX_DAILY_LOSS_PCT=1.5
MAX_TRADES_PER_DAY=3
MAX_LOSSES_PER_DAY=2

# 2026 contract specs (check NSE/BSE circulars)
LOT_NIFTY=65
LOT_SENSEX=20
LOT_BANKNIFTY=30
LOT_FINNIFTY=60

# charges (percent)
STT_OPT_SELL_PCT=0.15
STT_FUT_SELL_PCT=0.05
SLIPPAGE_PCT=0.1

# strategy switches
S2_SYMBOL=NIFTY
EVENT_DAYS=
S3_MODE=intraday
S3_USE_DELIVERY=false
NSE_HOLIDAYS=

# broker historical data / option chain (data/broker_historical.py, scripts/log_expiry_chain.py)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
KITE_API_KEY=
KITE_ACCESS_TOKEN=
S1_SYMBOL=NIFTY
S1_FLAG=true
S1_FLAG_GT_MIN=1.6
S2_WING_IV_MULT=1.35
S1_GT_MODE=min
