//@version=5
// Daily trend strategy from research.py ("ma_trend_nifty"): hold a stock while its close is above its
// N-day average AND the NIFTY 50 is above its 100-day average. A swing (delivery) strategy, not intraday.
// Use on a daily NSE chart. Strategy Tester shows TradingView's own backtest.
strategy("Angel bot - MA trend + NIFTY filter", overlay = true, initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.15, slippage = 1)

maLen    = input.int(50, "Stock average (days)", minval = 10)
niftyLen = input.int(100, "NIFTY average (days)", minval = 10)
useNifty = input.bool(true, "Only when NIFTY is above its average")

stockUp = close > ta.sma(close, maLen)
niftyUp = request.security("NSE:NIFTY", "D", close > ta.sma(close, niftyLen))
inTrend = stockUp and (not useNifty or niftyUp)

// orders fill at the next bar's open, as in research.py
if inTrend and strategy.position_size == 0
    strategy.entry("Trend", strategy.long)
if not inTrend and strategy.position_size > 0
    strategy.close("Trend")

plot(ta.sma(close, maLen), "Average", color.new(color.blue, 0))
bgcolor(useNifty and not niftyUp ? color.new(color.red, 92) : na, title = "NIFTY below its average")
