# Copy to .env and fill in. Never share .env. Times are India time (IST), money in rupees.

# Angel One SmartAPI (smartapi.angelone.in -> create an app for the API key).
# ANGEL_TOTP_SECRET is the text secret behind the authenticator QR code (enable TOTP on Angel One).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# SEBI rule (from April 2026): API orders only from a static IP registered with Angel One
STATIC_IP=

# false = paper trading (fake money, real prices). true = real orders, only if readiness.py passes.
LIVE_TRADING=false
PAPER_START_BALANCE=100000

# Universe: NIFTY50 | NIFTY100 | NIFTY200 | NIFTY500. WATCH=RELIANCE,TCS to fix the list.
UNIVERSE=NIFTY100
WATCH_SIZE=30
WATCH=
BLOCKED=
MIN_PRICE=50
NEWS_CHECK=true

# Entry: opening range 9:15-9:30, first 5-minute close above it triggers
OR_MINUTES=15
MIN_VOLUME_X=1.0
NO_ENTRIES_BEFORE=09:30
NO_ENTRIES_AFTER=14:30
USE_LEVEL_SETUP=true
TREND_FILTER=true

# Exit: or-mid | or-low | pct:X | atr:K ; target in R ; out by FLAT_BY (before Angel's auto square-off)
STOP_RULE=or-mid
LEVEL_STOP_RULE=atr:1.5
TARGET_R=2
FLAT_BY=15:10
ASSUMED_SPREAD_PCT=0.05

# Time Machine
TM_REPLAYS=10000
TM_SEED=19
TM_MIN_DAYS=20
TM_MIN_EDGE_PTS=0

# Budget and risk (rupees)
BUDGET=100000
CASH_BUFFER_PCT=10
MAX_POSITION_PCT=40
MAX_ORDER=40000
MIN_ORDER=2000
MAX_LOSS_PER_TRADE=500
MAX_DAILY_LOSS=1500
MAX_TRADES_PER_DAY=3
MAX_ORDERS_PER_DAY=10
MAX_OPEN_POSITIONS=2
MIN_REWARD_RISK=1.0
# 1 = no margin. Intraday leverage multiplies losses as much as gains.
LEVERAGE=1

# Charges (Angel One intraday equity; verify on angelone.in)
BROKERAGE_PCT=0.1
BROKERAGE_MAX=20
BROKERAGE_MIN=5
STT_SELL_PCT=0.025
EXCHANGE_TXN_PCT=0.00297
SEBI_FEE_PCT=0.0001
STAMP_BUY_PCT=0.003
GST_PCT=18

# TradingView webhook (optional): alerts from TradingView go through the same checks before any order
TV_WEBHOOK=false
TV_PORT=8787
TV_SECRET=
TV_ONLY=false

# Telegram (optional): token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Extra NSE holidays (YYYY-MM-DD, comma separated), e.g. for 2027
NSE_HOLIDAYS=

POLL_SECONDS=20
